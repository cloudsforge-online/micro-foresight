# Forge Foresight — every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. This file IS that declaration, and `src/env.ts` is the only place any of
# them is spelled. `env_file: .env` fan-out — one file handed to every container — is what put the
# custody master secret inside the marketing site, and it has nothing to justify it.
#
# EVERY SECRET HERE IS `CHANGE_ME`. `env.ts` refuses a known placeholder outright and refuses
# anything under 24 characters, so a copy of this file cannot boot: a placeholder that starts is a
# placeholder that reaches production.

# ─────────────────────────────────────────────────────────────────────────────────── the process
PORT=4021
NODE_ENV=development
LOG_LEVEL=info
# Names this replica in `jobs.locked_by`. The container id under compose, the pod name under
# Kubernetes — in both cases the thing an operator searches for after finding a stuck lease.
INSTANCE_ID=

# ─────────────────────────────────────────────────────────────────────────── the ONE database
# Rule 1: a service owns exactly one database and reads no other. CI greps the source for a second
# connection-string variable, so adding one fails the build rather than review.
FORESIGHT_DATABASE_URL=postgres://foresight:CHANGE_ME@127.0.0.1:5432/foresight
FORESIGHT_DATABASE_POOL_MAX=10

# ───────────────────────────────────────────────────────────────────────────────────── identity
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# ───────────────────────────────────────────────────────────────────────────────────── upstreams
# The scoped service credential. NEVER a shared one — SD-05. The scopes this token needs are
# `custody:sign:deployer`, `custody:address:create`, `indexer:read`, `indexer:write`,
# `ledger:post` and `policy:decide`, and no more.
FORESIGHT_SERVICE_TOKEN=CHANGE_ME
CUSTODY_URL=http://127.0.0.1:4005
INDEXER_URL=http://127.0.0.1:4008
LEDGER_URL=http://127.0.0.1:4007
POLICY_URL=http://127.0.0.1:4006
FORESIGHT_UPSTREAM_DEADLINE_MS=5000
FORESIGHT_POLICY_DEADLINE_MS=3000

# The action staking is decided under. `micro-policy`'s registry is CLOSED — an unregistered name
# is a 400, not a guess — and there is no `foresight.stake` in it yet. `trade.order.place` is the
# registered action whose description actually fits. Move this the day policy gains its own.
FORESIGHT_POLICY_ACTION=trade.order.place

# HMAC key for outbound event signatures, so a subscriber can prove an event came from us.
OUTBOX_SIGNING_SECRET=CHANGE_ME

# ───────────────────────────────────────────────────────────────────────────────────── the chain
# `chain -> JSON-RPC endpoint`, as JSON. EMPTY BY DEFAULT, and empty means a deploy is refused
# rather than falling back to a public node nobody chose.
FORESIGHT_RPC_URLS={"ember":"http://127.0.0.1:8545"}
FORESIGHT_RPC_DEADLINE_MS=5000

# TWO deliberate settings are needed to reach a mainnet, and this is why: a market on a mainnet
# holds real EMBER belonging to strangers, and one typo in FORESIGHT_NETWORK must not be enough.
FORESIGHT_NETWORK=testnet
FORESIGHT_MAINNET_ENABLED=false

# Where the settlement fee goes. Bound into every market contract at deploy time and unchangeable
# afterwards, so a wrong value here is a fee stream nobody can collect.
FORESIGHT_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# The custody-held address that may resolve or void a market. It is a `deployer`-purpose custody
# key: it can sign a zero-value contract creation and NOTHING ELSE, which is why the resolution is
# posted as a one-shot contract. See `src/resolve.ts`. The user id and order id are custody's
# binding for it and must match the row custody holds, character for character.
FORESIGHT_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
FORESIGHT_ORACLE_USER_ID=foresight
FORESIGHT_ORACLE_ORDER_ID=oracle-ember-testnet

# ───────────────────────────────────────────────────────────────────────────────── market defaults
# Basis points of the LOSING pool taken on settlement. A winner therefore never receives less than
# they staked. Hard-capped at 1000 (10%) by the contract itself.
FORESIGHT_DEFAULT_FEE_BPS=200
# 24 hours: long enough for a wrong resolution to be noticed by somebody who was asleep, short
# enough that a correct one does not feel like a withheld payment.
FORESIGHT_DEFAULT_DISPUTE_WINDOW_SECONDS=86400

# ─────────────────────────────────────────────────────────────────────────────── deploy and gas
FORESIGHT_DEPLOYS_ENABLED=true
FORESIGHT_MIN_GAS_PRICE_WEI=1000000000
FORESIGHT_MAX_GAS_PRICE_WEI=500000000000
FORESIGHT_DEPLOY_GAS_LIMIT=3000000
FORESIGHT_RESOLVE_GAS_LIMIT=300000
FORESIGHT_STUCK_MINUTES=30

# ───────────────────────────────────────────────────────────────────── the idea pipeline (optional)
# ALL FOUR MAY BE ABSENT, AND ABSENT IS A SUPPORTED MODE. The pipeline records "no proposals" and
# the operator queue stays empty; nothing crashes and nothing logs an error every six hours for a
# thing nobody has configured. An operator can write every market question by hand — `POST /ideas`
# is the same path — so a service that fell over without its suggester would have the dependency
# exactly backwards. `micro-notify`'s SMTP discipline.
FORESIGHT_SEARCH_URL=
FORESIGHT_SEARCH_TOKEN=
FORESIGHT_PROPOSER_URL=
FORESIGHT_PROPOSER_TOKEN=
FORESIGHT_PROPOSER_MODEL_ID=
FORESIGHT_PROPOSER_DEADLINE_MS=30000
FORESIGHT_PROPOSER_BATCH_SIZE=5

# ─────────────────────────────────────────────────────────────────────────────────────── jobs
# There is no `setInterval` in this repository — rule 8, and CI greps for one. Recurrence is a
# leased job that re-enqueues itself, which is the only form that is correct with two replicas.
FORESIGHT_LEASE_MS=60000
FORESIGHT_JOB_POLL_MS=1000
FORESIGHT_PROPOSE_EVERY_MINUTES=360

# ─────────────────────────────────────────────────────────────────────────────────────── tests
# Read by `src/testsupport.ts`. The name MUST contain "test": the harness truncates every table
# this service owns and refuses a database whose name does not say what it is.
# FORESIGHT_TEST_DATABASE_URL=postgres://foresight:foresight@127.0.0.1:55460/foresight_test
